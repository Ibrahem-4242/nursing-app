# ===================================================
# إعدادات Google AdSense
# استبدل المعرف التالي بمعرف الناشر الخاص بك من حساب AdSense
# ===================================================
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# ===================================================
# إعدادات الربط مع Google Apps Script / Google Sheets
# رابط Web App المنشور من سكربت البوت لاستقبال وتحديث البيانات
# ===================================================
APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/AKfycby4vIPoD5IRIwfCg6HN23uerHzBPP--_C85vcKrX7PAAS0GV6PGuSbHTe6_h0BwZvhSUA/exec

# معرف جدول البيانات Google Sheet ID (في حال استخدام Google Sheets API المباشر)
GOOGLE_SHEET_ID=your_spreadsheet_id_here
